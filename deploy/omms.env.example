# 复制为 omms.env 后按实际路径修改；两个服务读取同一份配置。
DB_PATH=/opt/omms/data/club_system.db
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=omms:
APP_UTC_OFFSET=+08:00
COOKIE_SECURE=1
HOST=127.0.0.1
PORT=2001
BIND=127.0.0.1:2002
NGINX_ACCESS_LOG=/opt/omms/run/nginx-access.log
# 内存 2 GB 以下的机器：口令校验最多占用 AUTH_CONCURRENCY × 19 MB。
# AUTH_CONCURRENCY=2
